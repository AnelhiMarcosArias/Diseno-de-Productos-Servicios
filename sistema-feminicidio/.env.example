# Copia este archivo a .env y actualiza los valores para tu instalación local.
DB_URL=jdbc:postgresql://localhost:5432/sistema_feminicidio
DB_USERNAME=postgres
DB_PASSWORD=
DB_DDL_AUTO=update
APP_FRONTEND_ORIGIN=http://localhost:5173

# Cuenta local de administración: establece una contraseña propia antes de reiniciar Spring.
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Administradora
AUTH_BOOTSTRAP_SURNAME=Inicial
